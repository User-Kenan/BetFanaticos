<Window x:Class="Betfanaticos.UI.WindowCreateAcc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrieren" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5">

        <Border Width="350"
                Padding="25"
                Background="White"
                CornerRadius="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Registrieren"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Benutzername"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="Textbox_Name"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         FontSize="16"
                         TextChanged="Textbox_Name_TextChanged"/>

                <TextBlock Text="Passwort"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="Textbox_Password"
                             Height="35"
                             Margin="0,0,0,25"
                             Padding="8"
                             FontSize="16"/>

                <Button Content="Jetzt registrieren"
                        Height="40"
                        Background="#2D89EF"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,0,15"
                        Click="Button_Create_acc"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>