<UserControl x:Class="Betfanaticos.UI.ChallengeCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#FF2A225A"
            CornerRadius="15"
            Padding="15"
            Margin="10">

        <StackPanel>

            <TextBlock x:Name="TitleText"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"/>

            <TextBlock x:Name="DescriptionText"
                       Foreground="LightGray"
                       Margin="0,5,0,10"/>

            <ProgressBar x:Name="ProgressBarChallenge"
                         Height="20"
                         Minimum="0"/>

            <TextBlock x:Name="ProgressText"
                       Foreground="White"
                       Margin="0,5,0,0"/>

            <TextBlock x:Name="RewardText"
                       Foreground="Gold"
                       FontWeight="Bold"
                       Margin="0,10,0,0"/>

        </StackPanel>

    </Border>
</UserControl>