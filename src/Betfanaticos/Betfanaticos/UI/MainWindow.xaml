<Window x:Class="Betfanaticos.UI.Mainwindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mainwindow" Height="450" Width="800">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="60" Background="#222">
            <Button Content="Games" Width="120" Margin="5" Click="Games_Click"/>
            <Button Content="Statistics" Width="120" Margin="5" Click="Statistics_Click"/>
            <Button Content="Settings" Width="120" Margin="5" Click="Settings_Click"/>
        </StackPanel>

        <ContentControl x:Name="MainContent"/>
    </DockPanel>
</Window>
