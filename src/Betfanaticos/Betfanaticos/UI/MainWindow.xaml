<Window x:Class="Betfanaticos.UI.Mainwindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Betfanaticos.UI"
        mc:Ignorable="d"
        Title="Mainwindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Background="BlueViolet"></Border>
        <Label Content="" FontSize="35" Name="LabelUser"></Label>
        <Label Content="Credits" Name="LabelCredits" FontSize="35" HorizontalAlignment="Right" Grid.Column="2"></Label>

        <Button Click="TextBoxBet" Grid.Column="1" Grid.Row="2" Margin="5" Content="Wetten" FontSize="20px"></Button>
        <Button Click="TextBoxChallange" Grid.Column="1" Grid.Row="3" Margin="5" Content="Challanges" FontSize="20px"></Button>
        <Button Click="TextBoxStatistics" Grid.Column="1" Grid.Row="4" Margin="5" Content="Statistik" FontSize="20px"></Button>
        <Button Click="TextBoxSettings" Grid.Column="1" Grid.Row="5" Margin="5" Content="Einstellungen" FontSize="20px"></Button>



    </Grid>
</Window>
