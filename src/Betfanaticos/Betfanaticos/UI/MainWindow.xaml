<Window x:Class="Betfanaticos.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Betfanaticos.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Background="BlueViolet"></Border>
        <Label x:Name="LabelUser" Content="Username" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
        <Label x:Name="LabelCredits" Content="Coins" FontSize="30" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>

        <Button Margin="10" Content="Wetten" Grid.Column="1" Grid.Row="2" Click="ButtonBet"></Button>
        <Button Margin="10" Content="Challanges" Grid.Column="1" Grid.Row="3" Click="ButtonChallanges"></Button>
        <Button Margin="10" Content="Statistiken" Grid.Column="1" Grid.Row="4" Click="ButtonStats"></Button>

    </Grid>
</Window>
