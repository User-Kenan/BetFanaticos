<Window x:Class="Betfanaticos.UI.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Betfanaticos.UI"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5">

        <Border Width="350"
                Padding="25"
                Background="White"
                CornerRadius="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <!-- Titel -->
                <TextBlock Text="Anmelden"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Benutzername -->
                <TextBlock Text="Benutzername"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtUsername"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"/>

                <!-- Passwort -->
                <TextBlock Text="Passwort"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="txtPassword"
                             Height="35"
                             Margin="0,0,0,25"
                             Padding="8"/>

                <!-- Login Button -->
                <Button x:Name="btnLogin"
                        Content="Anmelden"
                        Height="40"
                        Background="#2D89EF"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,0,20" Click="btnLogin_Click"/>

                <!-- Kein Account -->
                <TextBlock Text="Noch kein Account?"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <Button x:Name="btnRegister"
                        Content="Registrieren"
                        Height="35"
                        Background="#E0E0E0"
                        FontWeight="SemiBold"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>