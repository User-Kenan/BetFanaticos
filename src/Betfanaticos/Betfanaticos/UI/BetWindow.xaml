<Window x:Class="Betfanaticos.UI.BetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bet"
        Height="650"
        Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1446">

    <Border Background="#FF2A225A"
            CornerRadius="30"
            Margin="35"
            Padding="35">

        <StackPanel>

            <TextBlock Text="🎯 Place your Bet"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock x:Name="MatchText"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Betrag"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="AmountTextBox"
                     Height="48"
                     FontSize="20"
                     Padding="12"
                     Foreground="#FF1B1446"
                     Background="White"
                     BorderThickness="0"
                     Margin="0,0,0,25"/>

            <TextBlock Text="Team auswählen"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <RadioButton x:Name="HomeTeamRadio"
                         Foreground="White"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,5,0,12"/>

            <RadioButton x:Name="AwayTeamRadio"
                         Foreground="White"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,5,0,35"/>

            <Button Content="Wette speichern"
                    Height="50"
                    Width="200"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Click="SaveBet_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF6C5CE7"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Border>
</Window>