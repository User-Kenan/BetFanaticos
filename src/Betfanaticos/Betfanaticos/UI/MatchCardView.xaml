<UserControl x:Class="Betfanaticos.MatchCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#FF3B2D80"
            CornerRadius="20"
            Padding="15"
            Margin="10">

        <StackPanel>

            <TextBlock x:Name="TeamsText"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <TextBlock x:Name="DateText"
                       Foreground="#FFD0D0D0"
                       FontSize="16"
                       Margin="0,10,0,15"
                       HorizontalAlignment="Center"/>

            <Button Content="🎯 Bet"
                    Height="40"
                    Width="120"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Click="BetButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF5B4DB0"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </StackPanel>

    </Border>
</UserControl>