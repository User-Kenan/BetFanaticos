<Window x:Class="Betfanaticos.UI.MatchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Betfanaticos"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1446"
        WindowStyle="None"
        WindowState="Maximized">

    <Window.Resources>

        <Style x:Key="roundMenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF3B2D80"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="Margin" Value="10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zurück Button -->
        <Button Content="← Zurück"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="20,0,0,0"
                Width="170"
                Height="55"
                Style="{StaticResource roundMenuButton}"
                Click="Back_Click"/>

        <!-- Sportarten -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="⚽ Football"
                    Style="{StaticResource roundMenuButton}"
                    Click="Games_Click"/>

            <Button Content="🏀 Basketball"
                    Style="{StaticResource roundMenuButton}"
                    Click="Basketball_Click"/>

            <Button Content="⚾ MLB"
                    Style="{StaticResource roundMenuButton}"
                    Click="MLB_Click"/>

        </StackPanel>

        <Border Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,30,0"
                Background="#FF3B2D80"
                CornerRadius="20"
                Padding="20,10">

            <TextBlock x:Name="CoinsText"
                       Text="$ 1000"
                       Foreground="Gold"
                       FontSize="26"
                       FontWeight="Bold"/>
        </Border>

        <!-- Inhalt -->
        <Border Grid.Row="1"
                Background="#FF2A225A"
                CornerRadius="25"
                Margin="20">

            <ContentControl x:Name="MainContent"/>

        </Border>

    </Grid>

</Window>